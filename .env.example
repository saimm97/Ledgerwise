# Copy this file to .env and fill in real values. Never commit .env.

# --- Django ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Leave False (or unset) in production. True only on your own machine.
DJANGO_DEBUG=False
# Comma-separated host names this site answers to, for example: ledgerwise.example.com,www.ledgerwise.example.com
ALLOWED_HOSTS=
# Full origins (with https://) allowed to post forms, for example: https://ledgerwise.example.com
CSRF_TRUSTED_ORIGINS=
# Turn on once the site is served over HTTPS: secure cookies, redirect to HTTPS, HSTS.
HTTPS_ONLY=False
# Only behind a proxy / load balancer that sets X-Forwarded-Proto itself.
TRUST_PROXY_SSL_HEADER=False

# --- Database (Docker) ---
POSTGRES_DB=ledgerwise_db
POSTGRES_USER=ledgerwise_user
POSTGRES_PASSWORD=
# --- Database (local settings) ---
DB_PASSWORD=

# --- Redis (cache, login throttle, Celery) ---
REDIS_URL=redis://redis:6379/0

# --- Email ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
